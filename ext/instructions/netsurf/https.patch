+static nserror
+myos_address_url(const char *text, nsurl **url)
+{
+	while (*text == ' ' || *text == '\t')
+		text++;
+	size_t end = strcspn(text, ":/?#");
+	bool port = text[end] == ':' && text[end + 1] >= '0' && text[end + 1] <= '9';
+	if (port) {
+		const char *rest = text + end + 1;
+		rest += strspn(rest, "0123456789");
+		port = *rest == 0 || *rest == '/' || *rest == '?' || *rest == '#';
+	}
+	if (*text == 0 || *text == '/' || (text[end] == ':' && !port && *text != '['))
+		return nsurl_create(text, url);
+
+	char *address = malloc(strlen(text) + sizeof("https://"));
+	if (address == NULL)
+		return NSERROR_NOMEM;
+	strcpy(address, "https://");
+	strcat(address, text);
+	nserror error = nsurl_create(address, url);
+	free(address);
+	return error;
+}
