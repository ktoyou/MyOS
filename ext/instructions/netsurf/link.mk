myos-link: $(OBJECTS) $(MESSAGES_TARGET)/en/Messages
	ld -m elf_i386 -T $(MYOS_ROOT)/user/user.ld --gc-sections -Map=$(MYOS_ROOT)/build/netsurf.map -s -o $(MYOS_ROOT)/build/user/netsurf $(OBJECTS) --start-group $(MYOS_ROOT)/build/libnsfb-myos.a $(filter-out %/libnsfb.a,$(wildcard $(NS_PREFIX)/lib/*.a)) $(MYOS_ROOT)/build/curl/libcurl.a $(MYOS_ROOT)/build/openssl/libssl.a $(MYOS_ROOT)/build/openssl/libcrypto.a $(MYOS_ROOT)/build/user/libmyos.a $(MYOS_ROOT)/build/mlib/libm.a $(MYOS_ROOT)/build/mlib/libpng.a $(MYOS_ROOT)/build/mlib/libjpeg.a $(MYOS_ROOT)/build/mlib/libz.a $(MYOS_ROOT)/build/mlib/libexpat.a $(MYOS_ROOT)/build/mlib/libiconv.a $(MYOS_ROOT)/build/mlib/libc.a $(shell gcc -m32 -print-libgcc-file-name) --end-group
